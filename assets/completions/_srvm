#compdef srvm

autoload -U is-at-least

_srvm() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--port=[Start port search at N (0 chooses a free port)]:PORT:_default' \
'--select=[Run one app\: index, qualified id, or a unique name]:SELECT:_default' \
'--dry-run[]' \
'--no-open[]' \
'--no-install[]' \
'-v[]' \
'--verbose[]' \
'--quiet[]' \
'--no-color[]' \
'(--select)--all[Alias for the default set]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
'::dir:_files' \
&& ret=0
}

(( $+functions[_srvm_commands] )) ||
_srvm_commands() {
    local commands; commands=()
    _describe -t commands 'srvm commands' commands "$@"
}

if [ "$funcstack[1]" = "_srvm" ]; then
    _srvm "$@"
else
    compdef _srvm srvm
fi
